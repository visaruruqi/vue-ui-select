{
  "name": "vue-ui-select",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Vue 3 drop-in replacement for AngularJS ui-select — search, multi-select, tagging, grouping, theming",
  "keywords": [
    "vue",
    "vue3",
    "select",
    "multiselect",
    "tagging",
    "dropdown",
    "combobox",
    "ui-select",
    "select2",
    "selectize",
    "typeahead"
  ],
  "author": "",
  "repository": {
    "type": "git",
    "url": ""
  },
  "main": "./dist/vue-ui-select.umd.cjs",
  "module": "./dist/vue-ui-select.es.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/vue-ui-select.es.js",
      "require": "./dist/vue-ui-select.umd.cjs",
      "types": "./dist/types/index.d.ts"
    },
    "./themes/*": "./dist/themes/*"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.0",
    "@types/node": "^20.11.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.0",
    "autoprefixer": "^10.4.0",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^5.1.0",
    "vitest": "^1.3.0",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0",
    "vue-tsc": "^2.0.0"
  },
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "vite build && vue-tsc -p tsconfig.build.json --emitDeclarationOnly",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:headed": "npx playwright test --headed",
    "test:all": "vitest run && npx playwright test",
    "typecheck": "vue-tsc --noEmit",
    "prepublishOnly": "npm run build"
  }
}
